{
  "name": "pragmatical.ai",
  "version": "0.1.0",
  "private": true,
  "description": "The Pragmatical AI company site \u2014 built with our own framework.",
  "type": "module",
  "scripts": {
    "dev": "PORT=4400 node --watch --env-file-if-exists=.env serve-prod.js",
    "start": "PORT=4400 node --env-file-if-exists=.env serve-prod.js",
    "build": "cherga build",
    "deploy": "cherga build && npx wrangler deploy",
    "lint": "cherga lint pages components data",
    "check:ui": "node tools/check-ui.mjs",
    "check:chat-api": "node tools/check-chat-api.mjs",
    "check:assistant": "node tools/check-assistant-ui.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "optionalDependencies": {
    "@cherga/components": "file:../swc-js/components",
    "@cherga/composites": "file:../swc-js/composites",
    "@cherga/core": "file:../swc-js/core",
    "@cherga/server": "file:../swc-js/server",
    "@cherga/server-node": "file:../swc-js/server-node"
  }
}
