// Deploy config. `main` is the PRE-BUNDLED worker produced by
// tools/build-dist.mjs and committed to this repository; no_bundle uploads it
// verbatim, so the deploy resolves no imports and needs no framework checkout.
//
// Build before you commit:  npm run build
{
  "name": "pragmatical-ai",
  "main": "dist-worker/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-01",
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [{ "name": "CHAT_RATE_LIMIT", "namespace_id": "47391001", "simple": { "limit": 8, "period": 60 } }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // The worker answers every extensionless path by server-rendering it, so
    // the assets binding must not intercept a miss with its own 404 page.
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
